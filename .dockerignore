##############################################
# .NET / C# — build outputs (never needed in image)
##############################################

**/bin/
**/obj/
**/out/
**/publish/

# NuGet packages (restored inside the image)
**/.nuget/
**/packages/
!**/packages/build/
project.lock.json
project.fragment.lock.json
*.nupkg
*.snupkg

##############################################
# Entity Framework
##############################################

*.ef.cache

##############################################
# Test results & coverage
##############################################

**/TestResults/
**/coverage/
*.coverage
*.coveragexml
*.trx
BenchmarkDotNet.Artifacts/

##############################################
# Frontend — Node
##############################################

**/node_modules/
**/dist/
**/.next/
**/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

##############################################
# IDE / Editor
##############################################

.vs/
.vscode/
.idea/
_ReSharper*/
*.suo
*.user
*.userosscache
*.sln.docstates
*.sln.ide/
*.DotSettings.user

##############################################
# Docker — avoid recursive context issues
##############################################

docker-compose.override.yml
docker-compose.*.override.yml
.env
.env.*
!.env.example

##############################################
# Logs & runtime artifacts
##############################################

logs/
*.log
*.log.*
nohup.out

##############################################
# OS generated files
##############################################

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

##############################################
# Certificates & secrets — never in an image
##############################################

*.pfx
*.p12
*.key
*.pem
*.cer
*.crt
secrets.json
**/appsettings.Development.json
**/appsettings.Local.json
**/Properties/launchSettings.json

##############################################
# Git / docs — not needed at runtime
##############################################

.git/
.gitignore
.gitattributes
docs/
README.md
*.md
