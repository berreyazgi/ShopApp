##############################################
# .NET / C#
##############################################

# Build outputs
bin/
obj/
out/

# Publish outputs
publish/
/app/publish/

# NuGet
*.nupkg
*.snupkg
.nuget/
packages/
!**/packages/build/
project.lock.json
project.fragment.lock.json

# Visual Studio / Rider cache
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.sln.ide/

# Rider
.idea/

# ReSharper
_ReSharper*/
*.DotSettings.user

##############################################
# ASP.NET Core
##############################################

# Local launch settings (contains dev-only ports / env vars)
**/Properties/launchSettings.json

# Local overrides for appsettings — keep appsettings.json tracked
**/appsettings.Development.json
**/appsettings.Local.json

##############################################
# Entity Framework Core
##############################################

*.ef.cache

##############################################
# Docker
##############################################

docker-compose.override.yml
docker-compose.*.override.yml
.env
.env.*
!.env.example

##############################################
# Logs & runtime artifacts
##############################################

logs/
*.log
*.log.*
nohup.out

##############################################
# OS generated files
##############################################

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

##############################################
# IDE — VS Code
##############################################

.vscode/
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

##############################################
# Test results & coverage
##############################################

TestResults/
coverage/
*.coverage
*.coveragexml
*.trx
BenchmarkDotNet.Artifacts/

##############################################
# Node (if frontend tooling is added later)
##############################################

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

##############################################
# Certificates & secrets — never commit these
##############################################

*.pfx
*.p12
*.key
*.pem
*.cer
*.crt
secrets.json